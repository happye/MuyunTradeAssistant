# 本地敏感配置模板（ISS-042）—— 复制为 configs/settings.local.yaml 后填入真实 key。
# settings.local.yaml 已 gitignore，不入库。
# 此文件深合并覆盖到 configs/settings.yaml 之上（load_config 自动加载）。
# 也可改用环境变量 DEEPSEEK_API_KEY / KIMI_API_KEY，二者各入口均已支持兜底。

ai:
  deepseek:
    api_key: "sk-your-deepseek-key"
  kimi:
    api_key: "sk-your-kimi-key"
